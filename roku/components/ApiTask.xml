<?xml version="1.0" encoding="utf-8"?>
<!-- Sends requests to the server one at a time, in order. Set `request`, read `response`. -->
<component name="ApiTask" extends="Task">
    <interface>
        <field id="request" type="assocarray" />
        <field id="response" type="assocarray" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/ApiTask.brs" />
</component>
