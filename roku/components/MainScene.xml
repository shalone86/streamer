<?xml version="1.0" encoding="utf-8"?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <script type="text/brightscript" uri="pkg:/components/config.brs" />
    <children>
        <Rectangle id="bg" color="0x101418FF" width="1920" height="1080" />

        <Group id="menu">
            <Label id="title" text="Streamer" translation="[160,110]"
                font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
            <Label id="status" translation="[160,190]" width="1600"
                font="font:SmallSystemFont" color="0x98A4B0FF" />
            <LabelList id="list" translation="[160,290]" itemSize="[900,84]" itemSpacing="[0,12]"
                textHorizAlign="left" color="0xE8ECF0FF" focusedColor="0x101418FF"
                focusBitmapBlendColor="0xFFFFFFFF" />
            <Label id="help" translation="[1160,300]" width="620" wrap="true"
                font="font:SmallSystemFont" color="0x98A4B0FF"
                text="While watching:&#10;&#10;Arrows, OK: move and select on the page&#10;Play: play / pause&#10;Rewind / Fast-fwd: previous / next button on the page (Tab)&#10;Replay: full screen (f)&#10;* : switch to a mouse pointer and back&#10;Back: previous page&#10;Hold Back: return here" />
        </Group>

        <Video id="video" width="1920" height="1080" visible="false" enableUI="false" />

        <Rectangle id="badge" color="0x000000B0" width="380" height="64" translation="[1500,40]" visible="false">
            <Label id="badgeText" width="380" height="64" horizAlign="center" vertAlign="center"
                font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
        </Rectangle>

        <Timer id="repeatTimer" duration="0.12" repeat="true" />
        <Timer id="badgeTimer" duration="2" />
    </children>
</component>
