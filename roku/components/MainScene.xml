<?xml version="1.0" encoding="utf-8"?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <script type="text/brightscript" uri="pkg:/components/config.brs" />
    <children>
        <Rectangle id="bg" color="0x101418FF" width="1920" height="1080" />

        <Group id="menu">
            <Label id="title" text="Streamer" translation="[80,40]"
                font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
            <Label id="status" translation="[420,58]" width="1420"
                font="font:SmallSystemFont" color="0x98A4B0FF" />
            <!-- Row 0 is the menu (Search, the services...), then a row per genre -->
            <RowList id="rows" translation="[80,150]" itemComponentName="TitleTile"
                numRows="3" itemSize="[1780,300]" itemSpacing="[0,10]"
                rowItemSize="[[384,262]]" rowItemSpacing="[[24,0]]"
                showRowLabel="[true]" rowLabelOffset="[[0,10]]" rowLabelColor="0xFFFFFFFF"
                rowLabelFont="font:MediumBoldSystemFont"
                rowFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="floatingFocus" />
        </Group>

        <Video id="video" width="1920" height="1080" visible="false" enableUI="false" />

        <!-- Holds the focus while watching, so every remote key reaches onKeyEvent -->
        <Group id="keys" />

        <Rectangle id="badge" color="0x000000B0" width="380" height="64" translation="[1500,40]" visible="false">
            <Label id="badgeText" width="380" height="64" horizAlign="center" vertAlign="center"
                font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
        </Rectangle>

        <Timer id="repeatTimer" duration="0.12" repeat="true" />
        <Timer id="badgeTimer" duration="2" />
    </children>
</component>
