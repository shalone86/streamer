{
  "keys": {
    "up": {"key": "Up"},
    "down": {"key": "Down"},
    "left": {"key": "Left"},
    "right": {"key": "Right"},
    "OK": {"key": "Return"},
    "play": {"media": "toggle", "else": {"key": "space"}},
    "playonly": {"media": "toggle", "else": {"key": "space"}},
    "pause": {"media": "toggle", "else": {"key": "space"}},
    "rewind": {"media": "seek", "by": -10, "else": {"key": "shift+Tab"}},
    "fastforward": {"media": "seek", "by": 10, "else": {"key": "Tab"}},
    "replay": {"key": "f"},
    "back": {"key": "alt+Left"}
  },
  "mouse": {
    "up": {"move": [0, -40]},
    "down": {"move": [0, 40]},
    "left": {"move": [-40, 0]},
    "right": {"move": [40, 0]},
    "OK": {"click": 1},
    "play": {"media": "toggle", "else": {"key": "space"}},
    "playonly": {"media": "toggle", "else": {"key": "space"}},
    "pause": {"media": "toggle", "else": {"key": "space"}},
    "rewind": {"click": 4},
    "fastforward": {"click": 5},
    "replay": {"key": "Escape"},
    "back": {"key": "alt+Left"}
  }
}
